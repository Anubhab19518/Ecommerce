{
  "name": "nodejs-production-template",
  "version": "1.0.0",
  "description": "Production-grade Node.js/TypeScript modular monolith boilerplate",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tools/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"tools/**/*.js\"",
    "test": "jest --passWithNoTests",
    "test:fallow": "fallow",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watchAll --passWithNoTests",
    "migration:create": "npx sequelize-cli migration:generate --name",
    "migration:run": "ts-node src/infrastructure/database/migrator.ts up",
    "migration:rollback": "ts-node src/infrastructure/database/migrator.ts down",
    "migration:status": "ts-node src/infrastructure/database/migrator.ts status",
    "migration:dry-run": "ts-node src/infrastructure/database/migrator.ts dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "modular-monolith"
  ],
  "license": "MIT",
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "cls-hooked": "^4.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.4",
    "umzug": "^3.8.2",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/cls-hooked": "^4.3.8",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-modular-monolith": "file:./tools/eslint-plugin-modular-monolith",
    "eslint-plugin-prettier": "^5.2.1",
    "fallow": "^3.10.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
